{
  "$schema": "https://opencode.ai/config.json",
  "model": "local/reviewer",
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-swap (local)",
      "options": {
        "baseURL": "http://{llama-swap-server}:{llama-swap-port}/v1",
        "timeout": 1200000
      },
      "models": {
        "scout": {
          "name": "Scout (Qwen3.5 9B)",
          "tool_call": true,
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "reviewer": {
          "name": "Reviewer (gpt-oss 20B)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "coder": {
          "name": "Coder (Qwen3.8 27B)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  },
  "agent": {
    "investigate": {
      "description": "Read-only repo investigation. Finds relevant files, traces code paths, writes findings and a plan to .agent/PLAN.md.",
      "mode": "all",
      "model": "local/scout",
      "temperature": 0.2,
      "prompt": "You investigate codebases. Never modify project files. Use grep/glob and read narrow line ranges instead of whole files. Read .agent/TASK.md, find the relevant code, then write .agent/PLAN.md with: relevant files (path + why), root cause or approach, ordered implementation steps, and how to verify. Be concise.",
      "permission": {
        "edit": {
          "*": "deny",
          ".agent/*": "allow"
        },
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git log*": "allow",
          "git diff*": "allow",
          "ls*": "allow",
          "rg *": "allow",
          "grep *": "allow"
        }
      }
    },
    "build": {
      "description": "Implements the plan. Heaviest model; use for code changes.",
      "mode": "primary",
      "model": "local/coder",
      "temperature": 0.6,
      "prompt": "You implement code changes. Read .agent/PLAN.md first, and .agent/QA.md if it exists (fix every listed issue). Make the smallest change that satisfies the plan, follow the conventions in AGENTS.md, run the project's tests for what you touched, then append a short summary of what you changed to .agent/HANDOFF.md.",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "allow",
          "rm -rf*": "deny",
          "sudo*": "deny",
          "git push*": "deny",
          "git reset --hard*": "deny"
        }
      }
    },
    "qa": {
      "description": "Reviews the diff against the plan, runs tests, reports a PASS/FAIL verdict in .agent/QA.md.",
      "mode": "all",
      "model": "local/reviewer",
      "temperature": 0.2,
      "prompt": "You are a strict QA reviewer. Never modify project files. Read .agent/PLAN.md and .agent/HANDOFF.md, inspect the change with git diff, and run the relevant tests. Write .agent/QA.md. Its FIRST line must be exactly 'VERDICT: PASS' or 'VERDICT: FAIL'. On FAIL, list concrete, actionable issues (file, line, what is wrong, what to do). PASS only if the plan is fully implemented and tests pass.",
      "permission": {
        "edit": {
          "*": "deny",
          ".agent/*": "allow"
        },
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "php artisan test*": "allow",
          "vendor/bin/pest*": "allow",
          "vendor/bin/phpunit*": "allow",
          "npm run test*": "allow",
          "npm run lint*": "allow",
          "npm run build*": "allow"
        }
      }
    },
    "plan": {
      "model": "local/reviewer"
    },
    "explore": {
      "model": "local/scout"
    }
  },
  "command": {
    "loop": {
      "description": "Run the full investigate \u2192 build \u2192 QA loop on a task",
      "agent": "plan",
      "template": "The agent loop was just run for this task: $ARGUMENTS\n\nLoop output (last lines):\n!`agent-loop \"$ARGUMENTS\" 2>&1 | tail -n 40`\n\nRead .agent/QA.md and .agent/HANDOFF.md, then summarise: the verdict, what changed, and any remaining issues. Do not modify any files."
    },
    "scout": {
      "description": "Investigate a task and write .agent/PLAN.md (scout model)",
      "agent": "investigate",
      "template": "Write this task to .agent/TASK.md, then investigate the codebase and write .agent/PLAN.md.\n\nTask: $ARGUMENTS"
    },
    "implement": {
      "description": "Implement .agent/PLAN.md, fixing .agent/QA.md issues if present (coder model)",
      "agent": "build",
      "template": "Implement .agent/PLAN.md. If .agent/QA.md exists, fix every issue it lists. Append a summary to .agent/HANDOFF.md. $ARGUMENTS"
    },
    "review": {
      "description": "Review the change against the plan and write .agent/QA.md (reviewer model)",
      "agent": "qa",
      "template": "Review the current change against .agent/PLAN.md, run the relevant tests, and write .agent/QA.md. $ARGUMENTS"
    }
  }
}
